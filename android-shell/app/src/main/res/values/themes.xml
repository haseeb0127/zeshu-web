<?xml version="1.0" encoding="utf-8"?>
<resources>
  <color name="zeshu_splash_background">#FCFCF9</color>
  <color name="zeshu_emerald">#075E45</color>
  <style name="Theme.Zeshu" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:statusBarColor">@color/zeshu_splash_background</item>
    <item name="android:navigationBarColor">@color/zeshu_splash_background</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
    <item name="android:windowBackground">@color/zeshu_splash_background</item>
  </style>
  <style name="Theme.Zeshu.Starting" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/zeshu_splash_background</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/zeshu_glossy_icon</item>
    <item name="postSplashScreenTheme">@style/Theme.Zeshu</item>
  </style>
</resources>