# Zeshu environment variable manifest
# Copy to .env.local for local development. Never commit real secrets.
# Configure production values only in the active hosting provider's encrypted environment settings.

# Core Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payment router
# off = current Razorpay path only
# observe = calculate routing decisions without changing customer payments
# smart = route payments only after all enabled providers pass sandbox/live readiness checks
PAYMENT_ROUTER_MODE=off

# Razorpay (keep public and server key IDs from the same account/environment)
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree Payments (server-only; keep unset until merchant onboarding is complete)
# Webhook verification uses Cashfree's Secret Key with the webhook timestamp + raw body.
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# PhonePe Payment Gateway (server-only; keep unset until merchant onboarding is complete)
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_CALLBACK_USERNAME=
PHONEPE_CALLBACK_PASSWORD=

# Paytm Payment Gateway (server-only; keep unset until merchant onboarding is complete)
PAYTM_ENV=staging
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=

# Google Maps
GOOGLE_MAPS_ROUTES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# PlanAPI — canonical names
PLANAPI_MEMBER_ID=
PLANAPI_PASSWORD=
PLANAPI_TOKEN_ID=
# Live PlanAPI UPI/eKYC calls may debit the provider wallet. Keep OFF until
# credentials are rotated and provider/compliance readiness is approved.
PLANAPI_EKYC_EXECUTION_ENABLED=false

# Jagtial service-area enforcement
ENFORCE_JAGTIAL_SERVICE_AREA=false

# AI support
SUPPORT_AI_ENABLED=false
OPENAI_API_KEY=
SUPPORT_AI_MODEL=gpt-5.6-luna

# Support email notifications (optional)
SUPPORT_SMTP_HOST=
SUPPORT_SMTP_PORT=
SUPPORT_SMTP_USER=
SUPPORT_SMTP_PASSWORD=
SUPPORT_NOTIFICATION_TO=

# A1Topup (keep execution disabled until provider onboarding is production-ready)
A1TOPUP_USERNAME=
A1TOPUP_PASSWORD=
A1TOPUP_EXECUTION_ENABLED=false

# WhatsApp — keep sender/UI disabled until Meta + hosting readiness checks pass
SUPPORT_WHATSAPP_SENDER_ENABLED=false
NEXT_PUBLIC_SUPPORT_WHATSAPP_UI_ENABLED=false
CRON_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_SUPPORT_REPLY_TEMPLATE_NAME=
WHATSAPP_SUPPORT_REPLY_TEMPLATE_LANGUAGE=
WHATSAPP_SUPPORT_RESOLVED_TEMPLATE_NAME=
WHATSAPP_SUPPORT_RESOLVED_TEMPLATE_LANGUAGE=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Move & Travel — discovery/support can stay live while execution remains OFF.
# These flags do not make booking available by themselves; each service also needs
# a verified provider adapter, transaction/refund state machine and compliance sign-off.
MOVE_EXECUTION_ENABLED=false
MOVE_RIDES_EXECUTION_ENABLED=false
MOVE_COURIER_EXECUTION_ENABLED=false
MOVE_CAR_SHARE_EXECUTION_ENABLED=false
MOVE_TRAVEL_EXECUTION_ENABLED=false
ZESHU_RIDES_PROVIDER=
ZESHU_ONDEMAND_COURIER_PROVIDER=
ZESHU_CAR_SHARE_PROVIDER=
ZESHU_TRAVEL_PROVIDER=

# Zeshu Move & Travel — fail closed by default
# These flags only express operator intent. Customer booking remains hard-disabled in code
# until each service has a verified adapter, transaction state machine and compliance sign-off.
MOVE_EXECUTION_ENABLED=false
MOVE_RIDES_EXECUTION_ENABLED=false
MOVE_COURIER_EXECUTION_ENABLED=false
MOVE_CAR_SHARE_EXECUTION_ENABLED=false
MOVE_TRAVEL_EXECUTION_ENABLED=false
ZESHU_RIDES_PROVIDER=
ZESHU_ONDEMAND_COURIER_PROVIDER=
ZESHU_CAR_SHARE_PROVIDER=
ZESHU_TRAVEL_PROVIDER=

# India-wide shipping (server-only)
# Use a dedicated Shiprocket API user. Keep nationwide checkout off until live quote/profit tests pass.
ZESHU_COURIER_PROVIDER=shiprocket
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_PICKUP_POSTCODE=
